# 1. Берем официальный образ Python (slim — облегченная версия)
FROM python:3.13-slim
# 2. Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app
# 3. Копируем файлы зависимостей (это нужно для кэширования)
COPY pyproject.toml uv.lock ./
# 4. Копируем бинарник uv из официального образа Astral (самый быстрый способ)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
# 5. Устанавливаем зависимости (флаг --frozen гарантирует точное соответствие версий из uv.lock)
RUN uv sync --frozen --no-dev --no-install-project
# 6. Копируем весь остальной код проекта
COPY . .
# 7. Открываем порт 8000 (просто для документации, реальный проброс делается при запуске)
EXPOSE 8000
# 8. Команда для запуска сервера (важно: --host 0.0.0.0, иначе контейнер не будет виден снаружи)
CMD ["uv", "run", "uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]

